# ==================================================
# CampusPulse AI - Environment Configuration
# ==================================================

# Server Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Security & Authentication
# Generate a strong 32+ char key in production
JWT_SECRET_KEY=campuspulse_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Configuration
# Optional: Path to service account JSON file, or individual credentials
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=campuspulse-ai
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Set to true to force in-memory mock repository even if credentials exist (useful for tests/offline demo)
USE_MOCK_DATABASE=False

# Machine Learning Configuration
MODEL_PATH=app/ml/model/xgboost_crowd_model.json
SCALER_PATH=app/ml/model/preprocessor.joblib

# Virtual IoT Simulation Configuration
SIMULATION_INTERVAL_SECONDS=10
SIMULATION_AUTO_START=True
DEFAULT_SCENARIO=normal_day

# Crowd Categorization Thresholds (Percentages 0-100)
LOW_CROWD_THRESHOLD=40
MEDIUM_CROWD_THRESHOLD=70
